{
  "name": "chinese-spelling-buddy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:dict": "node scripts/build-dictionary.mjs",
    "build:decomp": "node scripts/build-decomposition.mjs",
    "build:hanzi": "node scripts/build-hanzi-data.mjs",
    "build:ocr": "node scripts/build-ocr-assets.mjs",
    "predev": "npm run build:dict && npm run build:decomp && npm run build:hanzi && npm run build:ocr",
    "prebuild": "npm run build:dict && npm run build:decomp && npm run build:hanzi && npm run build:ocr",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@gutenye/ocr-browser": "^1.4.8",
    "hanzi-writer": "^3.7.3",
    "lucide-react": "^1.27.0",
    "onnxruntime-web": "^1.27.0",
    "pinyin-pro": "^3.28.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-image-crop": "^11.1.2"
  },
  "devDependencies": {
    "@gutenye/ocr-models": "^1.4.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cedict-json": "^1.3.20251213",
    "hanzi-writer-data": "^2.0.1",
    "oxlint": "^1.71.0",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
